            { date: "2026-10-04", code: "MIX-02", dtRepair: 1.1, pmRegular: 3.0, pmDaily: 1.0, costDt: 350000, costPm: 350000, spkDt: 1, spkPm: 5, problem: "Motor feeder resin screw slip saat material pelet pekat", sparepart: "Pulley Timing Belt & Belt HTD-8M" },
            { date: "2026-10-03", code: "MLD-01", dtRepair: 1.8, pmRegular: 5.0, pmDaily: 1.5, costDt: 550000, costPm: 800000, spkDt: 1, spkPm: 8, problem: "Pin ejektor patah 1 titik & pembersihan air vent", sparepart: "Ejector Pin SKD61 & Copper Beryllium Bush" },
            { date: "2026-10-02", code: "CNV-01", dtRepair: 1.2, pmRegular: 3.5, pmDaily: 1.5, costDt: 320000, costPm: 400000, spkDt: 1, spkPm: 6, problem: "Splicing ulang sambungan belt Conveyor", sparepart: "Fastener Belt Stainless & Lem" },
            { date: "2026-10-01", code: "CRS-02", dtRepair: 1.0, pmRegular: 3.0, pmDaily: 1.0, costDt: 280000, costPm: 300000, spkDt: 1, spkPm: 5, problem: "Pisau rotary tumpul ganti celah clearance 0.3mm", sparepart: "Asah Pisau Rotary & Baut Grade 10.9" },

            // --- LOG BULAN SEPTEMBER 2026 ---
            { date: "2026-09-24", code: "INJ-03", dtRepair: 5.5, pmRegular: 7.0, pmDaily: 2.5, costDt: 3150000, costPm: 1100000, spkDt: 3, spkPm: 10, problem: "Transducer posisi linear injection rusak (pembacaan stroke loncat)", sparepart: "Linear Transducer Novotechnik 450mm" },
            { date: "2026-09-20", code: "PRT-02", dtRepair: 4.5, pmRegular: 6.0, pmDaily: 2.0, costDt: 2750000, costPm: 900000, spkDt: 2, spkPm: 9, problem: "Inverter motor utama printing trip overvoltage", sparepart: "Inverter Mitsubishi FR-D700 3.7kW" },
