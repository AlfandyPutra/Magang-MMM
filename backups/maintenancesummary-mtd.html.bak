        ];

        // Log Harian (Sep 2026, Okt 2026, Nov 1-10, Nov 11-17)
        const dailyMaintenanceLogs = [
            // --- LOG TANGGAL TERAKHIR: 2026-11-17 (7 Mesin memiliki aktivitas DT/PM) ---
            { date: "2026-11-17", code: "PRT-01", dtRepair: 3.5, pmRegular: 1.0, pmDaily: 0.5, costDt: 11500000, costPm: 350000, spkDt: 1, spkPm: 1, problem: "Motor Servo SEW error overload & tinta tidak rata", sparepart: "Repair Motor Servo SEW CFM112L/KTY/VR 400VAC (Rp 11.500.000)" },
            { date: "2026-11-17", code: "INJ-01", dtRepair: 2.5, pmRegular: 1.5, pmDaily: 0.5, costDt: 450000, costPm: 300000, spkDt: 1, spkPm: 1, problem: "Oscilating no 6 macet, rol isolating fontain no 7 macet", sparepart: "Swing Arm Roll Oscilating 20x115 (Rp 210.000), Bearing 6009 2RS" },
