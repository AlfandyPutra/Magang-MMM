            { date: "2026-11-07", code: "PRT-02", dtRepair: 2.5, pmRegular: 3.5, pmDaily: 1.5, costDt: 1850000, costPm: 550000, spkDt: 1, spkPm: 4, problem: "Lampu UV curing redup, penggantian ballast & reflektor", sparepart: "UV Lamp 400W High Intensity & Kabel Tahan Panas" },
            { date: "2026-11-06", code: "INJ-07", dtRepair: 2.2, pmRegular: 3.0, pmDaily: 1.0, costDt: 540000, costPm: 480000, spkDt: 1, spkPm: 4, problem: "Water flow meter cooling tersumbat kerak", sparepart: "Acrylic Flow Meter 4-Zone & Selang PU 12mm" },
            { date: "2026-11-05", code: "CHL-02", dtRepair: 2.0, pmRegular: 3.0, pmDaily: 1.0, costDt: 920000, costPm: 500000, spkDt: 1, spkPm: 3, problem: "Kontaktor kompresor chiller terbakar akibat lonjakan arus", sparepart: "Magnetic Contactor 3-Phase 40A & Thermal Overload" },
