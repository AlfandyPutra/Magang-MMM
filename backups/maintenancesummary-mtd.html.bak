<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MMS | Maintenance Summary (Month to Date) - PT Mitra Mulia Makmur</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            color: #1e293b;
        }

        /* Warna khas header tabel MMS */
        .mms-banner-yellow {
            background-color: #ffc107;
            color: #1f2937;
        }

        .mms-thead-blue {
            background-color: #4472c4;
            color: #ffffff;
        }

        /* Custom scrollbar untuk tabel responsif */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col">

    <!-- Top Navigation Bar (Menyerupai MMS Header) -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Brand & Menu Links -->
                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-2.5">
                        <!-- SVG Logo MMM Plastic -->
                        <div
                            class="w-9 h-9 bg-amber-400 rounded-lg flex items-center justify-center shadow-xs border border-amber-500">
                            <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" stroke-width="2.2"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                            </svg>
                        </div>
                        <div class="leading-tight">
                            <span class="font-bold text-lg tracking-tight text-gray-900 block">MMM</span>
                            <span
                                class="text-[10px] font-semibold tracking-widest text-gray-500 uppercase block -mt-1">PLASTIC</span>
                        </div>
                    </div>

                    <!-- Navigation Links (Desktop) -->
                    <nav class="hidden lg:flex items-center space-x-5 text-xs font-medium text-gray-600">
                        <span class="hover:text-blue-600 cursor-pointer">Approval</span>
                        <span class="hover:text-blue-600 cursor-pointer">Master ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Project ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Quality Assurance ▾</span>
                        <span class="text-blue-600 font-semibold border-b-2 border-blue-600 py-5 cursor-pointer">Report
                            ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Transaction ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Work ▾</span>
                    </nav>
                </div>

                <!-- Right Profile & Notification -->
                <div class="flex items-center gap-3">
                    <!-- Notification Badge -->
                    <div class="relative p-2 text-gray-500 hover:bg-gray-100 rounded-full cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                        </svg>
                        <span
                            class="absolute top-1 right-1 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">2</span>
                    </div>

                    <!-- User Account Info -->
                    <div class="flex items-center gap-2.5 pl-2 border-l border-gray-200">
                        <div
                            class="w-8 h-8 rounded-full bg-slate-700 text-white flex items-center justify-center text-xs font-bold">
                            PM
                        </div>
                        <div class="hidden sm:block text-left leading-tight">
                            <div class="text-xs font-bold text-gray-800">PLANNER MTC</div>
                            <div class="text-[10px] text-gray-500">ADMINISTRATION MAINTENANCE MACHINE</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Breadcrumb Bar -->
    <div class="bg-[#fdfbf7] border-b border-gray-200 py-2.5 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2 text-amber-700 font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
                <span>Dashboard</span>
                <span class="text-gray-400">/</span>
                <span>Report</span>
                <span class="text-gray-400">/</span>
                <span class="font-bold text-gray-800">Maintenance Summary (Month to Date)</span>
            </div>
            <div class="text-gray-500">
                Mode Tampilan: <span class="font-semibold text-blue-700">Month to Date / Custom Date Range</span> • Klik
                baris mesin untuk rincian log harian
            </div>
        </div>
    </div>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Toast Notification Box (Replaces alert) -->
        <div id="toastBox"
            class="hidden fixed bottom-5 right-5 z-50 bg-slate-800 text-white px-4 py-3 rounded-lg shadow-lg text-sm flex items-center gap-3 transition-opacity duration-300">
            <span id="toastIcon" class="text-emerald-400 font-bold">✓</span>
            <span id="toastMessage">Pesan notifikasi</span>
        </div>

        <!-- Card 1: Title & Filter Panel -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-200 p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-gray-100">
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-bold text-gray-900">Maintenance Summary</h1>
                        <span class="px-2.5 py-0.5 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full">MtD &
                            Custom Date</span>
                    </div>
                    <p class="text-xs sm:text-sm text-gray-500 mt-1">Rekapitulasi Downtime (Jam), Cost Pemeliharaan
                        (IDR), dan Realisasi SPK berdasarkan rentang tanggal & kategori mesin.</p>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-2">
                    <button onclick="resetFilters()"
                        class="px-3.5 py-2 text-xs font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition cursor-pointer">
                        Reset Default (MtD)
                    </button>
                    <button onclick="exportToExcel()"
                        class="px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-xs flex items-center gap-2 transition cursor-pointer"
                        title="Unduh laporan lengkap Excel dengan warna rapi, lebar kolom pas & format Rupiah">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                        </svg>
                        <span>Export Excel (.XLS)</span>
                    </button>
                    <button onclick="exportToCSV()"
                        class="px-3 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition cursor-pointer"
                        title="Unduh format data mentah CSV">
                        <span>CSV</span>
                    </button>
                </div>
            </div>

            <!-- Quick Date Presets Bar -->
            <div class="flex flex-wrap items-center gap-2 pt-3.5 pb-1">
                <span class="text-xs font-semibold text-gray-500 mr-1">Pintasan Periode:</span>
                <button type="button" onclick="setDatePreset('2026-08-01', '2026-08-31', 'Agustus 2026')"
                    id="preset-aug"
                    class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition cursor-pointer">
                    Agustus 2026
                </button>
                <button type="button" onclick="setDatePreset('2026-09-01', '2026-09-30', 'September 2026')"
                    id="preset-sep"
                    class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition cursor-pointer">
                    September 2026
                </button>
                <button type="button" onclick="setDatePreset('2026-10-01', '2026-10-31', 'Oktober 2026')"
                    id="preset-oct"
                    class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition cursor-pointer">
                    Oktober 2026
                </button>
                <button type="button" onclick="setDatePreset('2026-11-01', '2026-11-17', 'November 2026 (MtD)')"
                    id="preset-nov"
                    class="preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-blue-600 bg-blue-600 text-white transition cursor-pointer">
                    November 2026 (MtD)
                </button>
            </div>

            <!-- Filter Inputs Grid (5 Columns on Desktop) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 pt-3 items-end">
                <!-- Start Date -->
                <div>
                    <label for="startDate" class="block text-xs font-semibold text-gray-700 mb-1.5">Start Date (Dari
                        Tanggal)</label>
                    <input type="date" id="startDate" value="2026-11-01" min="2026-08-01" max="2026-11-17"
                        onchange="clearActivePreset(); applyFilters();"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                </div>

                <!-- End Date -->
                <div>
                    <label for="endDate" class="block text-xs font-semibold text-gray-700 mb-1.5">End Date (Sampai
                        Tanggal)</label>
                    <input type="date" id="endDate" value="2026-11-17" min="2026-08-01" max="2026-11-17"
                        onchange="clearActivePreset(); applyFilters();"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                </div>

                <!-- Kategori Mesin -->
                <div>
                    <label for="filterCategory" class="block text-xs font-semibold text-gray-700 mb-1.5">Kategori Mesin
                        Utama</label>
                    <select id="filterCategory" onchange="updateMachineDropdown(); applyFilters();"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                        <option value="ALL">Semua Kategori (24 Mesin)</option>
                        <option value="Injection">Injection (INJ)</option>
                        <option value="Printing">Printing (PRT)</option>
                        <option value="Utility">Utility (Compressor, Chiller, Mold)</option>
                        <option value="Lain-lain">Lain-lain (Conveyor, Mixing, Crushing)</option>
                    </select>
                </div>

                <!-- Filter Kode Mesin Spesifik -->
                <div>
                    <label for="filterMachineCode" class="block text-xs font-semibold text-gray-700 mb-1.5">Filter Kode
                        Mesin</label>
                    <select id="filterMachineCode" onchange="applyFilters()"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                        <option value="ALL">Semua Kode Mesin</option>
                    </select>
                </div>

                <!-- Pencarian Cepat / Tombol Cari -->
                <div>
                    <label for="searchInput" class="block text-xs font-semibold text-gray-700 mb-1.5">Cari Kode /
                        Problem</label>
                    <div class="flex gap-2">
                        <input type="text" id="searchInput" onkeyup="applyFilters()" placeholder="INJ-01, Servo..."
                            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none">
                        <button onclick="applyFilters()" title="Terapkan Filter"
                            class="bg-[#0088cc] hover:bg-[#0077b3] text-white px-3.5 py-2 rounded-lg flex items-center justify-center transition cursor-pointer shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Summary KPI Cards (4 Kartu Ringkasan Atas) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- KPI 1: Total DT Perbaikan -->
            <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-xs flex items-start justify-between">
                <div>
                    <p class="text-xs font-medium text-gray-500">Total DT</p>
                    <h3 id="kpiDtRepair" class="text-2xl font-bold text-red-600 mt-1">0 Jam</h3>
                    <p class="text-[11px] text-gray-400 mt-1">Akumulasi kerusakan pada periode</p>
                </div>
                <div class="p-2.5 bg-red-50 text-red-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </div>
            </div>

            <!-- KPI 2: Total DT Preventive (Reguler + Harian) -->
            <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-xs flex items-start justify-between">
                <div>
                    <p class="text-xs font-medium text-gray-500">Total PM</p>
                    <h3 id="kpiDtPm" class="text-2xl font-bold text-blue-600 mt-1">0 Jam</h3>
                    <p class="text-[11px] text-gray-400 mt-1">Akumulasi jadwal preventive (PM)</p>
                </div>
                <div class="p-2.5 bg-blue-50 text-blue-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
                    </svg>
                </div>
            </div>

            <!-- KPI 3: Total Cost Maintenance -->
            <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-xs flex items-start justify-between">
                <div>
                    <p class="text-xs font-medium text-gray-500">Total Cost Maintenance (IDR)</p>
                    <h3 id="kpiTotalCost" class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">Rp 0</h3>
                    <p id="kpiCostBreakdown" class="text-[11px] text-gray-500 mt-1">DT: Rp 0 • PM: Rp 0</p>
                </div>
                <div class="p-2.5 bg-amber-50 text-amber-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>

            <!-- KPI 4: Total Realisasi SPK -->
            <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-xs flex items-start justify-between">
                <div>
                    <p class="text-xs font-medium text-gray-500">Total SPK (DT & PM)</p>
                    <h3 id="kpiTotalSpk" class="text-2xl font-bold text-emerald-600 mt-1">0 SPK</h3>
                    <p id="kpiSpkBreakdown" class="text-[11px] text-gray-500 mt-1">SPK DT: 0 • SPK PM: 0</p>
                </div>
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </section>

        <!-- BAGIAN 1: TOP 5 DOWNTIME TERBESAR & DETAIL PROBLEM UTAMA -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-200 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="text-xs font-medium text-gray-500">Rentang Tanggal Aktif: <strong
                        class="text-gray-800 period-label">01 Nov 2026 — 17 Nov 2026</strong></span>
                <span class="text-xs text-blue-600 font-medium">*Otomatis menampilkan 5 mesin dengan jam downtime
                    tertinggi pada rentang tanggal terpilih</span>
            </div>

            <div
                class="mms-banner-yellow font-bold text-center py-2.5 px-4 rounded-t-lg text-sm sm:text-base tracking-wide uppercase">
                Top 5 Downtime Terbesar & Detail Problem Utama
            </div>
            <div class="overflow-x-auto border border-t-0 border-gray-200 rounded-b-lg">
                <table class="w-full text-xs sm:text-sm text-left border-collapse">
                    <thead class="mms-thead-blue">
                        <tr>
                            <th class="py-3 px-3 border-r border-blue-400/40 text-center w-14">Rank</th>
                            <th class="py-3 px-3 border-r border-blue-400/40">Kode Mesin</th>
                            <th class="py-3 px-3 border-r border-blue-400/40">Kategori</th>
                            <th class="py-3 px-3 border-r border-blue-400/40 text-right">Downtime (Jam)</th>
                            <th class="py-3 px-3 border-r border-blue-400/40 text-right">Total DT + PM (Jam)</th>
                            <th class="py-3 px-3">Detail Problem Utama</th>
                        </tr>
                    </thead>
                    <tbody id="top5TableBody" class="divide-y divide-gray-200">
                        <!-- Rendered via JS -->
                    </tbody>
                </table>
            </div>
        </section>

        <!-- BAGIAN 2: TABEL REKAP DOWNTIME MESIN (JAM) - FULL WIDTH ATAS -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-200 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="text-xs text-gray-500">Urutan: <strong class="text-gray-700">Total Jam Downtime Tertinggi →
                        Terendah</strong></span>
                <span class="text-[11px] bg-gray-100 text-gray-600 px-2.5 py-1 rounded font-medium">Satuan: Jam (Klik
                    baris untuk detail log)</span>
            </div>
            <div
                class="mms-banner-yellow font-bold text-center py-2.5 px-4 rounded-t-lg text-sm sm:text-base uppercase">
                Rekap Downtime Mesin (Jam)
            </div>
            <div class="overflow-x-auto border border-t-0 border-gray-200 rounded-b-lg">
                <table class="w-full text-xs sm:text-sm text-left border-collapse">
                    <thead class="mms-thead-blue">
                        <tr>
                            <th class="py-2.5 px-3 border-r border-blue-400/40 w-12 text-center">No</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40">Kode Mesin</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40">Nama / Spesifikasi Unit</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40">Kategori</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40 text-right">Downtime (Jam)</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40 text-right">PM (Jam)</th>
                            <th class="py-2.5 px-3 text-right font-bold bg-[#365fa8]">Total Jam</th>
                        </tr>
                    </thead>
                    <tbody id="dtHoursTableBody" class="divide-y divide-gray-200">
                        <!-- Rendered via JS -->
                    </tbody>
                    <tfoot id="dtHoursTableFoot"
                        class="bg-slate-100 font-bold text-gray-800 border-t-2 border-gray-300">
                        <!-- Total Row -->
                    </tfoot>
                </table>
            </div>
        </section>

        <!-- BAGIAN 3: TABEL REKAP COST MAINTENANCE (IDR) - FULL WIDTH BAWAH DENGAN KOLOM ALASAN / DETAIL PROBLEM -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-200 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="text-xs text-gray-500">Urutan: <strong class="text-gray-700">Total Cost Terbesar →
                        Terkecil</strong></span>
                <span class="text-[11px] bg-gray-100 text-gray-600 px-2.5 py-0.5 rounded font-medium">Satuan: Rupiah
                    (IDR) • Dilengkapi Rincian Problem & Spare Part</span>
            </div>
            <div
                class="mms-banner-yellow font-bold text-center py-2.5 px-4 rounded-t-lg text-sm sm:text-base uppercase">
                Rekap Cost Maintenance (IDR) & Detail Problem Perbaikan
            </div>
            <div class="overflow-x-auto border border-t-0 border-gray-200 rounded-b-lg">
                <table class="w-full text-xs sm:text-sm text-left border-collapse">
                    <thead class="mms-thead-blue">
                        <tr>
                            <th class="py-2.5 px-3 border-r border-blue-400/40 w-12 text-center">No</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40 whitespace-nowrap">Kode Mesin</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40">Kategori</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40 text-right whitespace-nowrap">Cost DT
                                Perbaikan</th>
                            <th class="py-2.5 px-3 border-r border-blue-400/40 text-right whitespace-nowrap">Cost
                                Preventive (PM)</th>
                            <th
                                class="py-2.5 px-3 border-r border-blue-400/40 text-right font-bold bg-[#365fa8] whitespace-nowrap">
                                Total Cost (IDR)</th>
                            <th class="py-2.5 px-3 min-w-[280px]">Alasan / Detail Problem Perbaikan & Spare Part</th>
                        </tr>
                    </thead>
                    <tbody id="costTableBody" class="divide-y divide-gray-200">
                        <!-- Rendered via JS -->
                    </tbody>
                    <tfoot id="costTableFoot" class="bg-slate-100 font-bold text-gray-800 border-t-2 border-gray-300">
                        <!-- Total Row -->
                    </tfoot>
                </table>
            </div>
        </section>

        <!-- BAGIAN 4: TABEL JUMLAH REALISASI SPK PER MESIN -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-200 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="text-xs text-gray-500">Perbandingan Tiket Kerja: <strong class="text-gray-700">SPK
                        Perbaikan (DT) vs SPK Preventive (PM)</strong></span>
                <span class="text-xs text-gray-500">Menampilkan <strong id="showingCount">0</strong> entri mesin</span>
            </div>
            <div
                class="mms-banner-yellow font-bold text-center py-2.5 px-4 rounded-t-lg text-sm sm:text-base uppercase">
                Jumlah Realisasi SPK per Mesin
            </div>
            <div class="overflow-x-auto border border-t-0 border-gray-200 rounded-b-lg">
                <table class="w-full text-xs sm:text-sm text-left border-collapse">
                    <thead class="mms-thead-blue">
                        <tr>
                            <th class="py-3 px-3 border-r border-blue-400/40">Kode Mesin</th>
                            <th class="py-3 px-3 border-r border-blue-400/40">Nama / Spesifikasi Unit</th>
                            <th class="py-3 px-3 border-r border-blue-400/40">Kategori</th>
                            <th class="py-3 px-3 border-r border-blue-400/40 text-center">Jumlah SPK DT (Perbaikan)</th>
                            <th class="py-3 px-3 border-r border-blue-400/40 text-center">Jumlah SPK PM (Preventive)
                            </th>
                            <th class="py-3 px-3 text-center font-bold bg-[#365fa8]">Total SPK</th>
                        </tr>
                    </thead>
                    <tbody id="spkTableBody" class="divide-y divide-gray-200">
                        <!-- Rendered via JS -->
                    </tbody>
                    <tfoot id="spkTableFoot" class="bg-slate-100 font-bold text-gray-800 border-t-2 border-gray-300">
                        <!-- Total Row -->
                    </tfoot>
                </table>
            </div>
        </section>

    </main>

    <!-- Footer (Menyerupai MMS Footer) -->
    <footer class="bg-white border-t border-gray-200 py-4 px-4 sm:px-6 lg:px-8 mt-8 text-xs text-gray-500">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
            <div>
                Copyright © 2026 <strong class="text-gray-800">PT Mitra Mulia Makmur (MMM Plastic)</strong>. All rights
                reserved.
            </div>
            <div class="bg-gray-100 px-3 py-1 rounded text-gray-700 font-medium">
                MMM Management System • Prototype MtD v1.0
            </div>
        </div>
    </footer>

    <!-- Modal Detail Mesin (Muncul saat baris mesin diklik) -->
    <div id="machineModal" onclick="closeModalOnBackdrop(event)"
        class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full shadow-2xl border border-gray-200 overflow-hidden"
            onclick="event.stopPropagation()">
            <!-- Modal Header -->
            <div class="bg-[#4472c4] text-white px-6 py-4 flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span id="modalCategoryBadge"
                            class="px-2 py-0.5 text-[10px] font-bold uppercase bg-white/20 rounded">Category</span>
                        <span id="modalPeriodBadge" class="text-xs text-blue-100">Periode</span>
                    </div>
                    <h3 id="modalTitle" class="text-lg font-bold mt-1">Kode Mesin — Nama Unit</h3>
                </div>
                <button onclick="closeModal()" class="text-white/80 hover:text-white p-1 rounded-lg cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-4 text-sm max-h-[75vh] overflow-y-auto">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="bg-red-50 border border-red-100 rounded-xl p-3">
                        <span class="text-xs text-red-600 font-semibold block">DT Perbaikan & Cost</span>
                        <strong id="modalDtInfo" class="text-base text-gray-900 mt-0.5 block">0 Jam • Rp 0</strong>
                    </div>
                    <div class="bg-blue-50 border border-blue-100 rounded-xl p-3">
                        <span class="text-xs text-blue-600 font-semibold block">DT Preventive (PM) & Cost</span>
                        <strong id="modalPmInfo" class="text-base text-gray-900 mt-0.5 block">0 Jam • Rp 0</strong>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs font-bold uppercase text-gray-500 mb-1.5">Catatan Problem & Sparepart Terpakai
                        (Periode Terpilih)</h4>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl p-3.5 text-gray-700 space-y-2">
                        <p id="modalProblemText" class="font-medium text-gray-900"></p>
                        <p id="modalSparepartText" class="text-xs text-gray-600"></p>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs font-bold uppercase text-gray-500 mb-2">Log Aktivitas & Kejadian Harian (Sesuai
                        Rentang Tanggal)</h4>
                    <div id="modalLogsList" class="space-y-2">
                        <!-- Rendered via JS -->
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="bg-gray-50 px-6 py-3 border-t border-gray-200 flex justify-end">
                <button onclick="closeModal()"
                    class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg cursor-pointer">
                    Tutup Detail
                </button>
            </div>
        </div>
    </div>

    <script>
        /**
         * ============================================================================
         * MMS (Maintenance Management System) - MtD Module
         * PT Mitra Mulia Makmur (MMM Plastic)
         *
         * Architecture:
         * 1. Data Store (Mock Master Data & Riwayat Log Harian)
         * 2. State Management
         * 3. Utility & Formatting Helpers
         * 4. Aggregation & Business Logic Engine
         * 5. View Renderers (Modular Table & KPI Renderers)
         * 6. Controller & Filter Orchestration
         * 7. Modal Handlers
         * 8. Data Export (CSV)
         * 9. Application Lifecycle & Event Listeners
         * ============================================================================
         */

        // ============================================================================
        // 1. DATA STORE (Database Simulasi Mesin & Log Pemeliharaan)
        // ============================================================================
        // Master Daftar 24 Mesin PT Mitra Mulia Makmur
        const masterMachines = [
            // Injection (8 Unit)
            { code: "INJ-01", unitName: "Mesin Injection EG-180T #01", category: "Injection" },
