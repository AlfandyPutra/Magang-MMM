            // Utility (6 Unit: Compressor, Chiller, Mold)
            { code: "CMP-01", unitName: "Compressor Screw Atlas Copco #01", category: "Utility" },
            { code: "CMP-02", unitName: "Compressor Booster High-Pressure #02", category: "Utility" },
