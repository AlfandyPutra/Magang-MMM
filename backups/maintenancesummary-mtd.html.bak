            { code: "MLD-02", unitName: "Mold Bowl 500ml Cavity-4 #02", category: "Utility" },
            // Lain-lain (6 Unit: Conveyor, Mixing, Crushing)
            { code: "CNV-01", unitName: "Conveyor Line Packing #01", category: "Lain-lain" },
