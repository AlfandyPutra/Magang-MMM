                            <div class="flex items-center justify-between">
                                <span class="w-14 font-semibold text-gray-600">MMM:</span>
                                <div class="flex-1 mx-2 bg-gray-200 rounded-full h-2 overflow-hidden">
                                    <div id="dtBranchBar_MMM" class="bg-red-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                                </div>
                                <span id="dtBranchVal_MMM" class="w-24 text-right font-medium text-gray-800">0 Jam</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="w-14 font-semibold text-gray-600">MMG:</span>
                                <div class="flex-1 mx-2 bg-gray-200 rounded-full h-2 overflow-hidden">
                                    <div id="dtBranchBar_MMG" class="bg-red-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                                </div>
                                <span id="dtBranchVal_MMG" class="w-24 text-right font-medium text-gray-800">0 Jam</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="w-14 font-semibold text-gray-600">MMS:</span>
                                <div class="flex-1 mx-2 bg-gray-200 rounded-full h-2 overflow-hidden">
                                    <div id="dtBranchBar_MMS" class="bg-red-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                                </div>
                                <span id="dtBranchVal_MMS" class="w-24 text-right font-medium text-gray-800">0 Jam</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="w-14 font-semibold text-gray-600">MMN:</span>
                                <div class="flex-1 mx-2 bg-gray-200 rounded-full h-2 overflow-hidden">
                                    <div id="dtBranchBar_MMN" class="bg-red-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                                </div>
                                <span id="dtBranchVal_MMN" class="w-24 text-right font-medium text-gray-800">0 Jam</span>
                            </div>
