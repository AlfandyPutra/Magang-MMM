    <!-- Modal Detail Mesin (Muncul saat baris mesin diklik) -->
    <div id="machineModal" onclick="closeModalOnBackdrop(event)"
        class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full shadow-2xl border border-gray-200 overflow-hidden"
            onclick="event.stopPropagation()">
            <!-- Modal Header -->
            <div class="bg-[#4472c4] text-white px-6 py-4 flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span id="modalCategoryBadge"
                            class="px-2 py-0.5 text-[10px] font-bold uppercase bg-white/20 rounded">Category</span>
                        <span id="modalPeriodBadge" class="text-xs text-blue-100">Periode</span>
                    </div>
                    <h3 id="modalTitle" class="text-lg font-bold mt-1">Kode Mesin — Nama Unit</h3>
                </div>
                <button onclick="closeModal()" class="text-white/80 hover:text-white p-1 rounded-lg cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-4 text-sm max-h-[75vh] overflow-y-auto">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="bg-red-50 border border-red-100 rounded-xl p-3">
                        <span class="text-xs text-red-600 font-semibold block">DT Perbaikan & Cost</span>
                        <strong id="modalDtInfo" class="text-base text-gray-900 mt-0.5 block">0 Jam • Rp 0</strong>
                    </div>
                    <div class="bg-blue-50 border border-blue-100 rounded-xl p-3">
                        <span class="text-xs text-blue-600 font-semibold block">DT Preventive (PM) & Cost</span>
                        <strong id="modalPmInfo" class="text-base text-gray-900 mt-0.5 block">0 Jam • Rp 0</strong>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs font-bold uppercase text-gray-500 mb-1.5">Catatan Problem & Sparepart Terpakai
                        (Periode Terpilih)</h4>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl p-3.5 text-gray-700 space-y-2">
                        <p id="modalProblemText" class="font-medium text-gray-900"></p>
                        <p id="modalSparepartText" class="text-xs text-gray-600"></p>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs font-bold uppercase text-gray-500 mb-2">Log Aktivitas & Kejadian Harian (Sesuai
                        Rentang Tanggal)</h4>
                    <div id="modalLogsList" class="space-y-2">
                        <!-- Rendered via JS -->
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="bg-gray-50 px-6 py-3 border-t border-gray-200 flex justify-end">
                <button onclick="closeModal()"
                    class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg cursor-pointer">
                    Tutup Detail
                </button>
            </div>
        </div>
    </div>

