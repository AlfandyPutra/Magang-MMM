<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MMS | Maintenance Summary (Month to Date) - PT Mitra Mulia Makmur</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Load Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            color: #1e293b;
        }

        /* Warna khas header tabel MMS */
        .mms-banner-yellow {
            background-color: #ffc107;
            color: #1f2937;
        }

        .mms-thead-blue {
            background-color: #4472c4;
            color: #ffffff;
        }

        /* Custom scrollbar untuk tabel responsif */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col">

    <!-- Top Navigation Bar (Menyerupai MMS Header) -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Brand & Menu Links -->
                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-2.5">
                        <!-- SVG Logo MMM Plastic -->
                        <div
                            class="w-9 h-9 bg-amber-400 rounded-lg flex items-center justify-center shadow-xs border border-amber-500">
                            <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" stroke-width="2.2"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                            </svg>
                        </div>
                        <div class="leading-tight">
                            <span class="font-bold text-lg tracking-tight text-gray-900 block">MMM</span>
                            <span
                                class="text-[10px] font-semibold tracking-widest text-gray-500 uppercase block -mt-1">PLASTIC</span>
                        </div>
                    </div>

                    <!-- Navigation Links (Desktop) -->
                    <nav class="hidden lg:flex items-center space-x-5 text-xs font-medium text-gray-600">
                        <span class="hover:text-blue-600 cursor-pointer">Approval</span>
                        <span class="hover:text-blue-600 cursor-pointer">Master ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Project ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Quality Assurance ▾</span>
                        <span class="text-blue-600 font-semibold border-b-2 border-blue-600 py-5 cursor-pointer">Report
                            ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Transaction ▾</span>
                        <span class="hover:text-blue-600 cursor-pointer">Work ▾</span>
                    </nav>
                </div>

                <!-- Right Profile & Notification -->
                <div class="flex items-center gap-3">
                    <!-- Notification Badge -->
                    <div class="relative p-2 text-gray-500 hover:bg-gray-100 rounded-full cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                        </svg>
                        <span
                            class="absolute top-1 right-1 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">2</span>
                    </div>

                    <!-- User Account Info -->
                    <div class="flex items-center gap-2.5 pl-2 border-l border-gray-200">
                        <div
                            class="w-8 h-8 rounded-full bg-slate-700 text-white flex items-center justify-center text-xs font-bold">
                            PM
                        </div>
                        <div class="hidden sm:block text-left leading-tight">
                            <div class="text-xs font-bold text-gray-800">PLANNER MTC</div>
                            <div class="text-[10px] text-gray-500">ADMINISTRATION MAINTENANCE MACHINE</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Breadcrumb Bar -->
    <div class="bg-[#fdfbf7] border-b border-gray-200 py-2.5 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2 text-amber-700 font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
                <span>Dashboard</span>
                <span class="text-gray-400">/</span>
                <span>Report</span>
                <span class="text-gray-400">/</span>
                <span class="font-bold text-gray-800">Maintenance Summary (Month to Date)</span>
            </div>
            <div class="text-gray-500">
                Mode Tampilan: <span class="font-semibold text-blue-700">Month to Date / Custom Date Range</span> • Klik
                baris mesin untuk rincian log harian
            </div>
        </div>
    </div>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Toast Notification Box (Replaces alert) -->
        <div id="toastBox"
            class="hidden fixed bottom-5 right-5 z-50 bg-slate-800 text-white px-4 py-3 rounded-lg shadow-lg text-sm flex items-center gap-3 transition-opacity duration-300">
            <span id="toastIcon" class="text-emerald-400 font-bold">✓</span>
            <span id="toastMessage">Pesan notifikasi</span>
        </div>

        <!-- Card 1: Title & Filter Panel -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-200 p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-gray-100">
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-bold text-gray-900">Maintenance Summary</h1>
                        <span class="px-2.5 py-0.5 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full">MtD &
                            Custom Date</span>
                    </div>
                    <p class="text-xs sm:text-sm text-gray-500 mt-1">Rekapitulasi Downtime (Jam), Cost Pemeliharaan
                        (IDR), dan Realisasi SPK berdasarkan rentang tanggal & kategori mesin.</p>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-2">
                    <button onclick="resetFilters()"
                        class="px-3.5 py-2 text-xs font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition cursor-pointer">
                        Reset Default (MtD)
                    </button>
                    <button onclick="exportToExcel()"
                        class="px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-xs flex items-center gap-2 transition cursor-pointer"
                        title="Unduh laporan lengkap Excel dengan warna rapi, lebar kolom pas & format Rupiah">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                        </svg>
                        <span>Export Excel (.XLS)</span>
                    </button>
                    <button onclick="exportToCSV()"
                        class="px-3 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition cursor-pointer"
                        title="Unduh format data mentah CSV">
                        <span>CSV</span>
                    </button>
                </div>
            </div>

            <!-- Quick Date Presets Bar -->
            <div class="flex flex-wrap items-center gap-2 pt-3.5 pb-1">
                <span class="text-xs font-semibold text-gray-500 mr-1">Pintasan Periode:</span>
                <button type="button"
                    onclick="setDatePreset('2026-11-01', '2026-11-10', '01 - 10 Nov 2026 (Data Riil Tiket)')"
                    id="preset-nov-real"
                    class="preset-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-blue-600 bg-blue-600 text-white transition cursor-pointer shadow-sm">
                    01 - 10 Nov 2026 (Data Riil Tiket)
                </button>
                <button type="button" onclick="setDatePreset('2026-11-01', '2026-11-30', 'November 2026 (MtD)')"
                    id="preset-nov"
                    class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition cursor-pointer">
                    November 2026 (MtD)
                </button>
                <button type="button" onclick="setDatePreset('2026-10-01', '2026-10-31', 'Oktober 2026')"
                    id="preset-oct"
                    class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition cursor-pointer">
                    Oktober 2026
                </button>
                <button type="button" onclick="setDatePreset('2026-09-01', '2026-09-30', 'September 2026')"
                    id="preset-sep"
                    class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition cursor-pointer">
                    September 2026
                </button>
            </div>

            <!-- Filter Inputs Grid (6 Columns on Desktop) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 pt-3 items-end">
                <!-- Cabang / Plant -->
                <div>
                    <label for="filterBranch" class="block text-xs font-semibold text-gray-700 mb-1.5">Cabang /
                        Plant</label>
                    <select id="filterBranch" onchange="updateMachineDropdown(); applyFilters();"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                        <option value="ALL">Semua Cabang (4 Pabrik)</option>
                        <option value="MMM">MMM (Sidoarjo)</option>
                        <option value="MMN">MMN (Nganjuk)</option>
                        <option value="MMS">MMS (Serang)</option>
                        <option value="MMG">MMG (Malang)</option>
                    </select>
                </div>

                <!-- Kategori Mesin -->
                <div>
                    <label for="filterCategory" class="block text-xs font-semibold text-gray-700 mb-1.5">Kategori
                        Mesin</label>
                    <select id="filterCategory" onchange="updateMachineDropdown(); applyFilters();"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                        <option value="ALL">Semua Kategori (248 Mesin)</option>
                        <option value="Injection">Injection</option>
                        <option value="Printing">Printing</option>
                        <option value="Utility">Utility</option>
                        <option value="Robot">Robot</option>
                        <option value="Auxiliary">Auxiliary</option>
                        <option value="Lain-lain">Lain-lain</option>
                    </select>
                </div>

                <!-- Start Date -->
                <div>
                    <label for="startDate" class="block text-xs font-semibold text-gray-700 mb-1.5">Start Date</label>
                    <input type="date" id="startDate" value="2026-11-01" min="2026-08-01" max="2026-11-30"
                        onchange="clearActivePreset(); applyFilters();"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                </div>

                <!-- End Date -->
                <div>
                    <label for="endDate" class="block text-xs font-semibold text-gray-700 mb-1.5">End Date</label>
                    <input type="date" id="endDate" value="2026-11-10" min="2026-08-01" max="2026-11-30"
                        onchange="clearActivePreset(); applyFilters();"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                </div>

                <!-- Filter Kode Mesin Spesifik -->
                <div>
                    <label for="filterMachineCode" class="block text-xs font-semibold text-gray-700 mb-1.5">Filter Unit
                        Mesin</label>
                    <select id="filterMachineCode" onchange="applyFilters()"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                        <option value="ALL">Semua Unit Mesin</option>
                    </select>
                </div>

                <!-- Pencarian Cepat / Tombol Cari -->
                <div>
                    <label for="searchInput" class="block text-xs font-semibold text-gray-700 mb-1.5">Cari Mesin /
                        Problem</label>
                    <div class="flex gap-2">
                        <input type="text" id="searchInput" onkeyup="applyFilters()"
                            placeholder="Cari kode/sparepart..."
                            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none">
                        <button onclick="applyFilters()" title="Terapkan Filter"
                            class="bg-[#0088cc] hover:bg-[#0077b3] text-white px-3.5 py-2 rounded-lg flex items-center justify-center transition cursor-pointer shrink-0 shadow-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Summary KPI Cards (4 Kartu Ringkasan Atas - Format Eksekutif Gambar 3) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- KPI 1: Total DT Perbaikan (Interactive Card) -->
            <div id="kpiCardDt" onclick="toggleDtDetail()"
                class="bg-white rounded-xl p-4 border-2 border-red-500 shadow-sm hover:shadow-md flex items-start justify-between cursor-pointer transition relative group">
                <div>
                    <div class="flex items-center gap-1.5">
                        <p class="text-xs font-semibold text-gray-600">Total DT</p>
                        <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-bold bg-red-100 text-red-700">Aktif</span>
                    </div>
                    <h3 id="kpiDtRepair" class="text-2xl font-extrabold text-red-600 mt-1 tracking-tight">0 Jam</h3>
                    <p class="text-[11px] text-gray-500 mt-1">Akumulasi kerusakan pada periode</p>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-red-600 mt-2 group-hover:underline">
                        <span id="cardDtActionText">Klik untuk Buka Detail DT</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </div>
                <div class="p-2.5 bg-red-50 text-red-600 rounded-lg shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </div>
            </div>

            <!-- KPI 2: Total DT Preventive (PM) -->
            <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-xs flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-600">Total PM</p>
                    <h3 id="kpiDtPm" class="text-2xl font-extrabold text-blue-600 mt-1 tracking-tight">0 Jam</h3>
                    <p class="text-[11px] text-gray-500 mt-1">Akumulasi jadwal preventive (PM)</p>
                    <span class="inline-flex items-center gap-1 text-[11px] text-blue-600 font-medium mt-2">
                        Jadwal terencana berkala
                    </span>
                </div>
                <div class="p-2.5 bg-blue-50 text-blue-600 rounded-lg shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
                    </svg>
                </div>
            </div>

            <!-- KPI 3: Total Cost Maintenance (Clickable for Cost) -->
            <div onclick="toggleSection('costDetailContainer', 'btnToggleCostText')"
                class="bg-white rounded-xl p-4 border border-gray-200 shadow-xs hover:shadow-md flex items-start justify-between cursor-pointer transition group">
                <div>
                    <p class="text-xs font-semibold text-gray-600">Total Cost Maintenance (IDR)</p>
                    <h3 id="kpiTotalCost" class="text-xl sm:text-2xl font-extrabold text-gray-900 mt-1 tracking-tight">Rp 0</h3>
                    <p id="kpiCostBreakdown" class="text-[11px] text-gray-500 mt-1">DT: Rp 0 • PM: Rp 0</p>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-700 mt-2 group-hover:underline">
                        <span id="btnToggleCostText">Buka Rincian Biaya</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </div>
                <div class="p-2.5 bg-amber-50 text-amber-600 rounded-lg shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>

            <!-- KPI 4: Total Realisasi SPK (Clickable for SPK) -->
            <div onclick="toggleSection('spkDetailContainer', 'btnToggleSpkText')"
                class="bg-white rounded-xl p-4 border border-gray-200 shadow-xs hover:shadow-md flex items-start justify-between cursor-pointer transition group">
                <div>
                    <p class="text-xs font-semibold text-gray-600">Total SPK (DT & PM)</p>
                    <h3 id="kpiTotalSpk" class="text-2xl font-extrabold text-emerald-600 mt-1 tracking-tight">0 SPK</h3>
                    <p id="kpiSpkBreakdown" class="text-[11px] text-gray-500 mt-1">SPK DT: 0 • SPK PM: 0</p>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 mt-2 group-hover:underline">
                        <span id="btnToggleSpkText">Buka Rincian SPK</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </div>
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-lg shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </section>

        <!-- ====================================================================== -->
        <!-- SECTION: EXECUTIVE DOWNTIME (DT) ANALYTICS & MONTHLY RATIO (SIMPLE VIEW) -->
        <!-- ====================================================================== -->
        <section id="dtAnalyticsSection" class="bg-white rounded-xl shadow-xs border border-gray-200 p-5 mt-4">
            <!-- Header Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3.5 border-b border-gray-100 mb-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-red-100 text-red-600 flex items-center justify-center font-bold">
                        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-sm sm:text-base font-bold text-gray-800">Analitik Downtime (DT) & Rasio Bulanan</h3>
                        <p class="text-xs text-gray-500">Evaluasi performa jam gangguan mesin & perbandingan rasio bulanan</p>
                    </div>
                </div>
                <!-- Tombol Buka/Tutup Detail DT -->
                <button type="button" onclick="toggleDtDetail()"
                    class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-red-600 hover:bg-red-700 text-white shadow-xs transition cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    <span id="btnDtDetailText">Buka Detail Tabel DT</span>
                    <svg id="iconDtDetailArrow" class="w-3.5 h-3.5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
            </div>

            <!-- Content Grid (Ringkasan Data DT + Grafik Rasio Bulanan) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                <!-- Col 1: Ringkasan Metrik Data DT (5 cols) -->
                <div class="lg:col-span-5 bg-slate-50/90 rounded-xl p-4 border border-slate-200 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-600 uppercase tracking-wider">Kinerja Downtime</span>
                            <span class="text-[11px] bg-red-100 text-red-700 font-bold px-2 py-0.5 rounded period-label">01 Nov 2026 — 10 Nov 2026</span>
                        </div>

                        <!-- Big Number Headline -->
                        <div class="mb-4">
                            <div class="flex items-baseline gap-2">
                                <span id="dtSummaryHours" class="text-3xl font-black text-red-600">0.0</span>
                                <span class="text-sm font-bold text-gray-700">Jam Total DT</span>
                            </div>
                            <p class="text-[11px] text-gray-500 mt-0.5">Akumulasi total jam kerusakan pada filter yang aktif</p>
                        </div>

                        <!-- Progress Bar Rasio DT vs PM -->
                        <div class="mb-4 bg-white p-3 rounded-lg border border-gray-200">
                            <div class="flex justify-between text-xs font-semibold mb-1.5">
                                <span class="text-red-600">DT (Kerusakan): <span id="dtRatioText">0%</span></span>
                                <span class="text-blue-600">PM (Preventive): <span id="pmRatioText">0%</span></span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3 flex overflow-hidden">
                                <div id="dtBarRatio" class="bg-red-500 h-3 transition-all duration-500" style="width: 0%"></div>
                                <div id="pmBarRatio" class="bg-blue-500 h-3 transition-all duration-500" style="width: 0%"></div>
                            </div>
                        </div>

                        <!-- 3 Stat Boxes Grid -->
                        <div class="grid grid-cols-3 gap-2">
                            <div class="bg-white p-2.5 rounded-lg border border-gray-200 text-center">
                                <span class="block text-[10px] text-gray-500 font-medium">Rata-rata / Hari</span>
                                <span id="dtDailyAvg" class="block text-sm font-bold text-gray-800 mt-0.5">0 Jam</span>
                            </div>
                            <div class="bg-white p-2.5 rounded-lg border border-gray-200 text-center">
                                <span class="block text-[10px] text-gray-500 font-medium">Mesin Rusak</span>
                                <span id="dtMachinesCount" class="block text-sm font-bold text-gray-800 mt-0.5">0 Mesin</span>
                            </div>
                            <div class="bg-white p-2.5 rounded-lg border border-gray-200 text-center">
                                <span class="block text-[10px] text-gray-500 font-medium">Tiket SPK DT</span>
                                <span id="dtTicketCount" class="block text-sm font-bold text-gray-800 mt-0.5">0 SPK</span>
                            </div>
                        </div>
                    </div>

                    <!-- Sebaran DT per Cabang -->
                    <div class="mt-4 pt-3 border-t border-slate-200">
